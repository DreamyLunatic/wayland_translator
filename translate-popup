#!/usr/bin/env bash
set -uo pipefail

text="$(wl-paste --no-newline --type text/plain 2>/dev/null)" || exit 0
[[ -z "${text//[[:space:]]/}" ]] && exit 0

result="$(printf '%s' "$text" | trans -e "bing" -brief -no-ansi :ru 2>&1)"
[[ -z "$result" ]] && result="Ошибка: перевод не получен"

printf '%s\n' "$result" |
    wofi --dmenu --cache-file /dev/null --prompt "Translation" \
         --width 700 --height 300 --lines 8 >/dev/null
